        this.singletonCImpl = singletonCImpl;
        this.activityRetainedCImpl = activityRetainedCImpl;
        this.viewModelCImpl = viewModelCImpl;
        this.id = id;
      }

      @SuppressWarnings("unchecked")
      @Override
      public T get() {
        switch (id) {
          case 0: // com.assentia.app.presentation.viewmodel.AdminDashboardViewModel 
          return (T) new AdminDashboardViewModel(viewModelCImpl.getAllPacientesUseCase(), viewModelCImpl.getIncidenciasAbiertasUseCase());

          case 1: // com.assentia.app.presentation.viewmodel.AgendaViewModel 
          return (T) new AgendaViewModel(viewModelCImpl.getVisitasHoyUseCase(), viewModelCImpl.getVisitasByCuidadorUseCase(), viewModelCImpl.getAllPacientesUseCase(), viewModelCImpl.iniciarVisitaUseCase());

          case 2: // com.assentia.app.presentation.viewmodel.AuthViewModel 
          return (T) new AuthViewModel(viewModelCImpl.loginUseCase(), viewModelCImpl.logoutUseCase(), viewModelCImpl.getCurrentUserUseCase());

          case 3: // com.assentia.app.presentation.viewmodel.ChatViewModel 
          return (T) new ChatViewModel(viewModelCImpl.getMensajesUseCase(), viewModelCImpl.enviarMensajeUseCase());

          case 4: // com.assentia.app.presentation.viewmodel.DetalleVisitaViewModel 
          return (T) new DetalleVisitaViewModel(viewModelCImpl.getVisitaByIdUseCase(), viewModelCImpl.getPacienteByIdUseCase(), viewModelCImpl.iniciarVisitaUseCase(), viewModelCImpl.completarVisitaUseCase(), viewModelCImpl.completarTareaUseCase(), viewModelCImpl.getMedicacionPacienteUseCase(), viewModelCImpl.getRegistrosMedicacionUseCase(), viewModelCImpl.registrarMedicacionUseCase());

          case 5: // com.assentia.app.presentation.viewmodel.FamiliarHomeViewModel 
          return (T) new FamiliarHomeViewModel(viewModelCImpl.getPacientesByFamiliarUseCase(), viewModelCImpl.getVisitasByPacienteUseCase(), viewModelCImpl.getUnreadCountUseCase());

          case 6: // com.assentia.app.presentation.viewmodel.IncidenciasViewModel 
          return (T) new IncidenciasViewModel(viewModelCImpl.getIncidenciasByPacienteUseCase(), viewModelCImpl.getIncidenciasAbiertasUseCase(), viewModelCImpl.createIncidenciaUseCase(), viewModelCImpl.resolverIncidenciaUseCase());

          case 7: // com.assentia.app.presentation.viewmodel.PacientesViewModel 
          return (T) new PacientesViewModel(viewModelCImpl.getAllPacientesUseCase(), viewModelCImpl.createPacienteUseCase(), viewModelCImpl.updatePacienteUseCase());

          default: throw new AssertionError(id);
        }
