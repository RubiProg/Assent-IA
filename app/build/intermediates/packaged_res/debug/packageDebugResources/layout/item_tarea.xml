<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">
    <CheckBox android:id="@+id/cb_completada" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/tv_tipo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/accent" android:textStyle="bold" />
        <TextView android:id="@+id/tv_descripcion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
